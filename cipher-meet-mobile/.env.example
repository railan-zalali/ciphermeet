# ─── Backend ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ciphermeet
POSTGRES_PASSWORD=changeme_dev
POSTGRES_DB=ciphermeet

# ─── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ciphermeet

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=15m

# ─── FCM Push Notifications ────────────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Cloud Messaging
FCM_SERVER_KEY=

# ─── Storage (Cloudflare R2 / AWS S3) ─────────────────────────────────────────
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=ciphermeet
STORAGE_CDN_BASE=https://cdn.ciphermeet.app

# ─── OTP Config ─────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
